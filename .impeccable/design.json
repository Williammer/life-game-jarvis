  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared action; active candidate variables replace the A preview fallback.",
      "html": "<button class=\"ds-button ds-primary\">确认，接受这些任务</button>",
      "css": ".ds-button{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;border:1px solid var(--line,#bccfce);border-radius:7px;padding:10px 16px;background:var(--paper,#fffefa);color:var(--ink,#18383e);font-size:14px;font-weight:600;min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-button:hover{background:var(--soft,#d9e9e9);border-color:var(--accent,#17616a)}.ds-button:focus-visible{outline:3px solid var(--accent,#17616a);outline-offset:4px}.ds-button:disabled{opacity:.6;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--accent,#17616a);border-color:var(--accent,#17616a);color:white}.ds-primary:hover{background:var(--accent,#17616a);filter:brightness(.94)}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered action used for proposals and corrections.",
      "html": "<button class=\"ds-button\">更新今日情况</button>",
      "css": ".ds-button{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;border:1px solid var(--line,#bccfce);border-radius:7px;padding:10px 16px;background:var(--paper,#fffefa);color:var(--ink,#18383e);font-size:14px;font-weight:600;min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-button:hover{background:var(--soft,#d9e9e9);border-color:var(--accent,#17616a)}.ds-button:focus-visible{outline:3px solid var(--accent,#17616a);outline-offset:4px}.ds-button:disabled{opacity:.6;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Quiet tertiary action; warning color is a separate state.",
      "html": "<button class=\"ds-button ds-text\">撤回记录</button>",
      "css": ".ds-button{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;border:1px solid var(--line,#bccfce);border-radius:7px;padding:10px 16px;background:var(--paper,#fffefa);color:var(--ink,#18383e);font-size:14px;font-weight:600;min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-button:hover{background:var(--soft,#d9e9e9);border-color:var(--accent,#17616a)}.ds-button:focus-visible{outline:3px solid var(--accent,#17616a);outline-offset:4px}.ds-button:disabled{opacity:.6;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-text{background:transparent;border-color:transparent;color:var(--negative,#9f3434);padding-inline:8px}.ds-text:hover{background:var(--soft,#d9e9e9);border-color:var(--accent,#17616a)}"
    },
