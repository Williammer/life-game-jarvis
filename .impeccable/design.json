      "css": ".ds-field{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;display:grid;gap:6px;font-size:13px;font-weight:600;color:var(--ink,#18383e)}.ds-field input{font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;width:100%;background:var(--paper,#fffefa);border:1px solid var(--line,#bccfce);border-radius:6px;padding:9px 10px;color:var(--ink,#18383e);min-height:44px;font-size:14px;caret-color:var(--accent,#17616a)}.ds-field input:focus-visible{outline:3px solid var(--accent,#17616a);outline-offset:4px}"
