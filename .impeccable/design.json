  "narrative": {
    "northStar": "Jarvis comparison lab — 远征图谱 / 策略牌桌 / 证据工坊",
    "overview": "This is a scan of three candidate worlds inside one throwaway interactive prototype, not one approved production identity. A expresses progression through maps, routes and chapters; B makes budget choices tangible through task cards and a ledger; C treats progress as an evidence document. Their names and visual descriptions come from the built artifact. The user’s preference remains pending.\n\nShared chrome and native controls make the alternatives comparable. Chinese system typography, quiet paper surfaces and compact state text support reading and action; the three palettes and signature structures remain separate. This record describes the current build, not a new set of design decisions. Surface composition and mode remain in `.impeccable/surfaces/game-lab.md`.",
    "keyCharacteristics": [
      "Three distinct candidate palettes with shared semantic color roles.",
      "Chinese system typography; tabular numbers for time, budgets and XP.",
      "A route map, B selectable task cards and C evidence documents.",
      "Text and semantic state accompany color; keyboard focus remains visible on controls.",
      "CSS and inline SVG carry the visuals; no shipping raster assets or external fonts."
    ],
    "rules": [
      {
        "name": "Candidate Boundary",
        "body": "Keep A, B and C token sets separate in this lab. None is the approved production identity; user preference remains pending.",
        "section": "colors"
      },
      {
        "name": "Readable State",
        "body": "Retain the text labels and semantic selection attributes that accompany color changes in the built controls.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use each candidate’s complete palette with its existing map, card or document structure.",
      "Do retain visible control focus, labeled fields, textual state and reduced-motion behavior.",
      "Do distinguish action XP, evidence validation and measured results in the labels already present.",
      "Do keep prototype comparison controls visually identifiable as lab chrome."
    ],
    "donts": [
      "Don’t treat these alternatives or their descriptive names as a user-approved production identity.",
      "Don’t introduce external fonts or raster imagery into this record; neither ships in the prototype.",
      "Don’t turn the removed above-heading state badge or removed mobile chapter eyebrow into a reusable pattern."
    ]
  }
