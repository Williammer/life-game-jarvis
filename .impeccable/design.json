      "html": "<button class=\"ds-map-node\" aria-pressed=\"true\"><strong>反向传播实现</strong><small>下一步 · 待证据</small></button>",
      "css": ".ds-map-node{--bg:#eef4f4;--paper:#fffefa;--ink:#18383e;--muted:#49676b;--accent:#17616a;--soft:#d9e9e9;--line:#bccfce;--warm:#8b5511;--positive:#246646;--negative:#9f3434;font-family:\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;display:flex;flex-direction:column;gap:4px;align-items:center;border:1px solid var(--line,#bccfce);background:var(--paper,#fffefa);color:var(--ink,#18383e);border-radius:10px;padding:13px 17px;min-width:125px;text-align:center;box-shadow:0 4px 12px #0000000b;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-map-node:hover{border-color:var(--accent,#17616a)}.ds-map-node[aria-pressed=true]{border:2px solid var(--accent,#17616a);box-shadow:0 5px 18px #00000018}.ds-map-node strong{font-size:14px}.ds-map-node small{font-size:12px;color:var(--muted,#49676b)}.ds-map-node:focus-visible{outline:3px solid var(--accent,#17616a);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-map-node{transition:none}}"
    },
    {
